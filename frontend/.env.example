# ---------------------------------------------------------------------------
# Copy to `.env` (git-ignored) if you need overrides.
# ---------------------------------------------------------------------------

# Leave EMPTY to use the Vite dev proxy (/api -> http://127.0.0.1:8000).
# Set to your deployed backend for direct browser -> backend calls, e.g.
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Proxy target used by vite.config.js (must include protocol).
VITE_BACKEND_URL=http://127.0.0.1:8000