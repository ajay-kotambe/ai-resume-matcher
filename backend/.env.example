# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env      (Windows: copy .env.example .env)
# `.env` is git-ignored -- NEVER commit real keys.
# Every value below is optional; the defaults shown are what the app uses.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
RELOAD=true

# --- CORS (comma-separated frontend origins) --------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite for MVP) ---------------------------------------------
DATABASE_URL=sqlite:///./app.db
SQL_ECHO=false

# --- NVIDIA NIM (OpenAI-compatible chat completions) -----------------------
# Get a key at https://build.nvidia.com
# LEAVE THIS EMPTY to run fully offline: extraction and explanations fall back
# to deterministic heuristics and the app still works end to end.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_TIMEOUT=120
NVIDIA_MAX_RETRIES=2

# Set to false to fail loudly instead of falling back when the AI call fails.
ALLOW_HEURISTIC_FALLBACK=true

# --- Embeddings (local, sentence-transformers) -----------------------------
# Downloaded on first use, then cached. No API key or network needed after that.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Resume processing -----------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MIN_EXTRACTABLE_CHARS=50

# --- Matching weights (must sum to 100) ------------------------------------
# Kept in config so scoring is transparent and tunable, never hardcoded.
WEIGHT_SKILL=40.0
WEIGHT_EXPERIENCE=25.0
WEIGHT_EDUCATION=15.0
WEIGHT_SEMANTIC=10.0
WEIGHT_EVIDENCE=10.0
